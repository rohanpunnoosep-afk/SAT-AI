# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# Launch-SAT-App.command loads .env automatically; for other entry points run
#   set -a; . ./.env; set +a
# in your shell first (or export the variables in ~/.zshrc).

# Required for AI question generation (the rest of the app works without it).
OPENAI_API_KEY=

# Optional overrides (defaults shown in README.md).
# OPENAI_MODEL=
# OPENAI_VALIDATOR_MODEL=
# OPENAI_BASE_URL=
# SAT_VALIDATE_ANSWERS=on
# SAT_WRITER_REASONING_EFFORT=medium
# SAT_VALIDATOR_REASONING_EFFORT=high
# SAT_DISTRACTOR_REASONING_EFFORT=low
# DB_PATH=data/questions.db
# PORT=8080
