# ==========================================================================
# SAT Tutoring — .gitignore
# This file lives at the repo root and is shared with everyone who clones.
# It tells Git which files to NEVER track. Anything listed here stays local.
# ==========================================================================

# --- SECRETS: never commit these ------------------------------------------
src/main/resources/credentials.json
/tokens/
# Local, machine-specific Claude Code settings
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Common secret patterns (belt-and-suspenders)
*.env
.env
.env.*
*.pem
*.p12
*.key

# --- Keep the safe template (negate the credentials ignore above) ---------
!src/main/resources/credentials.json.example

# --- Build output (regenerated by Maven) ----------------------------------
target/

# --- Generated / local helper files ---------------------------------------
cp.txt

# --- Local data & test fixtures -------------------------------------------
/ExtraDocuments/

# --- OS / editor junk ------------------------------------------------------
.DS_Store
**/.DS_Store
Thumbs.db
*.iml
.idea/
.vscode/

# --- tasks/ is its OWN nested git repo (pushed to the private tasks remote) -
tasks/

# --- Question bank data (large, unlicensed, not redistributable) ----------
# Imported SQLite DB (generated by the importer) + the raw
# cb-digital-questions.json (~25 MB). Source data lives OUTSIDE this repo.
/data/
vendor/sat-question-bank/
